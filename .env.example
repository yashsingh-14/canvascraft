# Artify Studio (CanvasCraft) — environment variables
#
# ── Database (required) ────────────────────────────────────────
# Default: Local zero-config SQLite (works instantly on Windows / macOS / Linux)
DATABASE_URL="file:./dev.db"

# Or if you deploy with PostgreSQL server (Neon, Supabase, Docker, etc.):
# DATABASE_URL="postgresql://user:password@localhost:5432/canvascraft"

# ── AI provider (optional) ─────────────────────────────────────
# Artify Studio works without any AI provider (local canvas & design features keep working).
# When these are set, AI features (Magic Layers, Assistant, Magic Write,
# image generation/editing, translate, photo search) activate.
# Credentials are SERVER-SIDE ONLY — never exposed to the browser.
#
# ZAI_BASE_URL=https://your-provider.example/v1
# ZAI_API_KEY=your-key

# ── AI agents / MCP server (optional) ─────────────────────────
# Model Context Protocol endpoint: POST /api/mcp
# Lets AI assistants create & edit designs on this server.
# ARTIFY_MCP_TOKEN=change-me-to-a-long-random-secret
